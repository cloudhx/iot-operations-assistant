{
  "name": "iot-operations-assistant",
  "version": "0.0.1",
  "description": "A GenAI-enabled IoT operations application with grounded tool use, RAG, human approval, evaluation, and execution tracing.",
  "author": "Han Xiao",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file=.env ./node_modules/.bin/nest start",
    "start:dev": "node --env-file=.env ./node_modules/.bin/nest start --watch",
    "start:debug": "node --env-file=.env ./node_modules/.bin/nest start --debug --watch",
    "start:prod": "node --env-file=.env dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "mcp:test": "npm run build && node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/integration/mcp/mcp-stdio.integration-spec.ts --reporter=verbose --no-file-parallelism",
    "ai:http:test": "npm run build && node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/integration/ai/http/device-assistant-http.integration-spec.ts --reporter=verbose --no-file-parallelism",
    "ai:approval:http:test": "npm run build && node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/integration/ai/http/pending-actions-http.integration-spec.ts --reporter=verbose --no-file-parallelism",
    "api:openapi:test": "npm run build && node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/integration/openapi/openapi.integration-spec.ts --reporter=verbose --no-file-parallelism",
    "ai:test": "npm run build && node --env-file=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/e2e/ai/device-assistant.e2e-spec.ts --reporter=verbose",
    "ai:evaluate": "npm run build && node --env-file=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/evals/device-assistant/device-assistant.evaluation-spec.ts --reporter=verbose --no-file-parallelism",
    "rag:retrieve": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/integration/ai/rag/document-retrieval.integration-spec.ts --reporter=verbose --no-file-parallelism",
    "rag:evaluate": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/evals/rag/rag-answer.evaluation-spec.ts --reporter=verbose --no-file-parallelism",
    "ai:evaluate:integrated": "npm run build && node --env-file=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/evals/device-assistant/device-assistant.integrated.evaluation-spec.ts --reporter=verbose --no-file-parallelism",
    "ai:evaluate:actions": "npm run build && node --env-file=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/evals/device-assistant/device-assistant.actions.evaluation-spec.ts --reporter=verbose --no-file-parallelism",
    "ai:evaluate:traces": "npm run build && node --env-file=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/evals/device-assistant/device-assistant.trace.evaluation-spec.ts --reporter=verbose --no-file-parallelism",
    "auth:http:test": "npm run build && node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts test/integration/auth/auth-http.integration-spec.ts --reporter=verbose --no-file-parallelism",
    "authz:policy:test": "opa test policy/ -v",
    "authz:pdp:start": "opa run --server --addr 127.0.0.1:8181 policy/"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "iron-session": "^9.0.1",
    "openid-client": "^6.8.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
